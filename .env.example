# Without a key, Knock runs its explicitly labeled deterministic demo.
CLINE_API_KEY=
CLINE_MODEL=anthropic/claude-sonnet-4.6

# ── Email verification (Nodemailer / Gmail SMTP) ──────────────────────────────
# Without these vars the app falls back to a dev-only "click to verify" button
# in the UI (devLink). No real email is sent.
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to myaccount.google.com/apppasswords
#   3. Create an App Password (Mail > Other).
#   4. Paste the 16-char code as SMTP_PASS below.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Knock <your@gmail.com>

# Base URL used to construct the verification link in the email.
# Change to your deployed domain in production.
PUBLIC_APP_URL=http://localhost:3000